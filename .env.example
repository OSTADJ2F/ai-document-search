# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# Services
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/document_search
REDIS_URL=redis://redis:6379/0

# Storage and uploads
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/data/uploads
MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_PER_MINUTE=60
SEARCH_CACHE_TTL_SECONDS=60
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI providers. Start llama-server separately; use extractive for a no-model fallback.
EMBEDDING_PROVIDER=local
GENERATION_PROVIDER=llama_cpp
LLAMA_CPP_BASE_URL=http://host.docker.internal:8080
LLAMA_CPP_MODEL=qwen-local
LLAMA_CPP_TIMEOUT_SECONDS=120
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=120
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=120
OPENAI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
